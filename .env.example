# JuniorMayWork — приклад конфігу. Скопіюй в .env і підлаштуй під себе.
# Backend читає змінні з оточення:
#   Linux/macOS:  export $(grep -v '^#' .env | xargs)
#   PowerShell:  $env:JMW_DATABASE_URL="postgres://postgres:ПАРОЛЬ@localhost:5432/jmw" (тощо для кожної змінної)

# PostgreSQL (локальний, без Docker).
# 1) Створи базу: psql -U postgres -c "CREATE DATABASE jmw;"
# 2) Впиши свій пароль користувача postgres нижче.
JMW_DATABASE_URL=postgres://postgres:PASSWORD@localhost:5432/jmw

# HTTP API + WebSocket
JMW_ADDR=:8080
JMW_ALLOWED_ORIGIN=http://localhost:3000

# Скрейпер
JMW_POLL_INTERVAL=90s
JMW_SOURCES=upwork,reddit,weblancer

# Куди виносити зниклі замовлення (JSON-архів)
JMW_ARCHIVE_DIR=./data/archive
