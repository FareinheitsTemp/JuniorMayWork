# JuniorMayWork — приклад конфігу. Скопіюй в .env і підлаштуй під себе.
# Backend читає змінні з оточення: export $(grep -v '^#' .env | xargs)

# PostgreSQL (відповідає docker-compose.yml)
JMW_DATABASE_URL=postgres://jmw:jmw@localhost:5432/jmw

# HTTP API + WebSocket
JMW_ADDR=:8080
JMW_ALLOWED_ORIGIN=http://localhost:3000

# Скрейпер
JMW_POLL_INTERVAL=90s
JMW_SOURCES=upwork,reddit,weblancer

# Куди виносити зниклі замовлення (JSON-архів)
JMW_ARCHIVE_DIR=./data/archive
