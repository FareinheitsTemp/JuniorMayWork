# JuniorMayWork — приклад конфігу (усе опційно; дефолти вказані в коментарях).
# Backend читає змінні з оточення:
#   PowerShell:  $env:JMW_POLL_INTERVAL="30s" (тощо для кожної змінної)

# База даних.
#  - JMW_DATABASE_URL порожня (за замовчуванням) => вбудований PostgreSQL,
#    який бекенд піднімає сам у ./data/pg (порт 5433).
#    Нічого встановлювати не треба; перший запуск скачає ~40МБ бінарників.
#  - Або вкажи зовнішню базу:
#    postgres://postgres:ПАРОЛЬ@localhost:5432/jmw
#JMW_DATABASE_URL=
JMW_EMBEDDED_PORT=5433
JMW_DATA_DIR=./data

# HTTP API + WebSocket
JMW_ADDR=:8080
JMW_ALLOWED_ORIGIN=http://localhost:3000

# Скрейпер
JMW_POLL_INTERVAL=90s
JMW_SOURCES=upwork,reddit,weblancer,kwork

# Куди виносити зниклі замовлення (JSON-архів)
JMW_ARCHIVE_DIR=./data/archive
